  "components": {
    "schemas": {
      "DeviceList": {
        "type": "object",
        "required": [
          "sessions"
        ],
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceSession"
            }
          }
        }
      },
      "DeviceSession": {
        "type": "object",
        "required": [
          "id",
          "created_at",
          "last_seen_at",
          "current"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "current": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "user_agent": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "milestone"
        ],
        "properties": {
          "milestone": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "user",
          "csrf_token",
          "mfa_required"
        ],
        "properties": {
          "csrf_token": {
            "type": "string"
          },
          "mfa_required": {
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        }
      },
      "RenameRequest": {
        "type": "object",
        "required": [
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Role": {
        "type": "string",
        "enum": [
          "USER",
          "ADMIN",
          "SUPER_ADMIN"
        ]
      },
      "SessionUser": {
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "mfa_enabled"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mfa_enabled": {
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      }
    },
