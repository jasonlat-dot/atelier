DATABASE_URL=postgres://atelier:atelier_local_only@127.0.0.1:5432/atelier
REDIS_URL=redis://:atelier_local_redis@127.0.0.1:6379
# Existing WSL deployment: PostgreSQL port 15432, Redis port 16380.
# Use your dedicated role/password; services/api/.env is ignored by Git.
# For tests, put DATABASE_URL (CREATEDB role) and TEST_REDIS_URL in .env.test.local.
BIND_ADDRESS=127.0.0.1:8080
WEB_DIR=../../apps/web/dist
# Only loopback binding accepts this development option. Production default: false.
EXPOSE_OPENAPI=false
RUST_LOG=atelier_app=info,atelier_wallet=info,tower_http=info

# Required, HTTPS in production; loopback HTTP is permitted for local development.
PUBLIC_BASE_URL=http://127.0.0.1:5173

# Required server-only Google Web OAuth credentials. Never put these in VITE_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required: base64 of 32 fresh random bytes. No default key is provided.
MASTER_KEY=
BOOTSTRAP_ADMIN_EMAILS=
# Optional: exact IPs of trusted reverse proxies, comma separated.
# Only these peers may supply a single X-Real-IP; ignore all other forwarding headers.
TRUSTED_PROXY_IPS=
